{
  "name": "glyphwire",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "start": "remotion studio",
    "render:preview": "remotion render BrandPreview out/brand-preview.mp4",
    "typecheck": "tsc --noEmit",
    "render:tariff": "remotion render TariffShort out/tariff-preview.mp4",
    "render:story": "remotion render Short out/story-preview.mp4",
    "validate": "node --test scripts/validate.test.mjs && node scripts/validate.mjs && npm run visual:check",
    "render:baseline": "remotion render TariffBaseline out/tariff-baseline.mp4",
    "visual:check": "node --experimental-strip-types --test scripts/hero-art.test.mjs"
  },
  "dependencies": {
    "@remotion/google-fonts": "4.0.200",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.200"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.200",
    "@types/react": "18.3.3",
    "typescript": "5.4.5"
  }
}
