{
  "name": "GlyphWire",
  "palette": {
    "primary": "#A3E635",
    "secondary": "#38BDF8",
    "alert": "#FF625C",
    "background": "#0B0F14",
    "panel": "#111820",
    "text": "#F7F8F2",
    "border": "#1F2A36",
    "muted": "#B8C0B0"
  },
  "typography": {
    "display": "Space Grotesk",
    "body": "Montserrat",
    "label": "Oxanium",
    "sizes1080": {
      "headline": 80,
      "persistentHeadline": 40,
      "subhead": 60,
      "body": 48,
      "label": 36,
      "header": 32,
      "minimum": 32
    },
    "roles": {
      "header": {
        "family": "Oxanium",
        "weight": 500,
        "size": 32,
        "style": "normal"
      },
      "openingHeadline": {
        "family": "Space Grotesk",
        "weight": 600,
        "size": 80,
        "maxSize": 96,
        "style": "normal"
      },
      "persistentHeadline": {
        "family": "Space Grotesk",
        "weight": 600,
        "size": 40,
        "style": "normal"
      },
      "topic": {
        "family": "Oxanium",
        "weight": 600,
        "size": 36,
        "style": "normal"
      },
      "topicSubtext": {
        "family": "Oxanium",
        "weight": 500,
        "size": 60,
        "style": "normal"
      },
      "bottomText": {
        "family": "Montserrat",
        "weight": 500,
        "size": 48,
        "style": "normal"
      },
      "directQuote": {
        "family": "Montserrat",
        "weight": 500,
        "size": 48,
        "style": "italic"
      },
      "quoteAttribution": {
        "family": "Montserrat",
        "weight": 500,
        "size": 32,
        "style": "normal"
      },
      "keyFigure": {
        "family": "Oxanium",
        "weight": 600,
        "size": "adaptive",
        "style": "normal"
      },
      "secondaryLabel": {
        "family": "Oxanium",
        "weight": 500,
        "size": 32,
        "style": "normal"
      }
    }
  },
  "motion": {
    "durationMs": {
      "fast": 160,
      "base": 360,
      "slow": 720
    },
    "easing": {
      "out": [
        0.2,
        0.8,
        0.2,
        1
      ],
      "in": [
        0.4,
        0,
        1,
        1
      ]
    },
    "staggerMs": 80,
    "tickerPxPerSec": 120
  },
  "frame": {
    "width": 1080,
    "height": 1920,
    "aspect": "9:16",
    "fps": 60
  },
  "logo": {
    "file": "brand/logo/glyphwire-mark.svg",
    "note": "Signal G. Lime only, no cyan in the mark."
  }
}
